<!DOCTYPE html>
<html>
	<head>
		{% set siteUrl = get_parametre_value(constant('App\\Entity\\Parametre::CODE_SITE_URL')) %}
		{% set logoSite = get_parametre_value(constant('App\\Entity\\Parametre::CODE_LOGO_SITE')) %}
		{% set themeCss = get_parametre_value(constant('App\\Entity\\Parametre::CODE_THEME_CSS')) %}
		{% set customCss = get_parametre_value(constant('App\\Entity\\Parametre::CODE_CUSTOM_CSS')) %}

		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">

		<title>{% block title %}ATAIS Informatique{% endblock %}</title>
		<link rel="icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">
		<link rel="shortcut icon" href="{{ asset('favicon.ico') }}" type="image/x-icon">

		{% if siteUrl %}
			<link rel="canonical" href="{{ siteUrl ~ app.request.pathInfo }}">
		{% endif %}

		{% block stylesheets %}
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

			{# CSS fixe du projet #}
			<link rel="stylesheet" href="{{ asset('css/site.css') }}">

			{# CSS du thème uploadé depuis l’admin #}
			{% if themeCss %}
				<link rel="stylesheet" href="{{ asset('uploads/styles/' ~ themeCss) }}">
			{% endif %}

			{# CSS personnalisé optionnel, chargé après le thème pour surcharger #}
			{% if customCss %}
				<link rel="stylesheet" href="{{ asset('uploads/styles/' ~ customCss) }}">
			{% endif %}
		{% endblock %}

		{% block javascripts %}
			{% block importmap %}{{ importmap('app') }}{% endblock %}
			<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
		{% endblock %}
	</head>

	<body>
		<div class="body">
			{% include 'partials/_navbar.html.twig' with {
				menus: get_menus(),
				logoSite: logoSite
			} %}

			<div role="main" class="main">
				{% block body %}{% endblock %}
			</div>
		</div>
	</body>
</html>