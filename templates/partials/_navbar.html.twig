<header id="header" class="header-effect-shrink">
	<div class="header-body border-top-0 box-shadow-none">
		<div class="header-container container py-2">
			<div class="header-row">
				<div class="header-column">
					<div class="header-row">
						<div class="header-logo">
							<a href="{{ path('app_home') }}">
								{% if logoSite is defined and logoSite %}
									{% set logoPath = logoSite starts with 'uploads/' ? logoSite : blocs_upload_path ~ '/' ~ logoSite %}

									<img
										src="{{ asset(logoPath) }}"
										alt="ATAIS Informatique"
										width="160"
										height="60"
										style="max-height: 58px; width: auto;"
									>
								{% else %}
									<span class="font-weight-bold text-color-dark text-5">
										ATAIS Informatique
									</span>
								{% endif %}
							</a>
						</div>
					</div>
				</div>

				<div class="header-column justify-content-end">
					<div class="header-row">
						<div class="header-nav header-nav-links order-2 order-lg-1">
							<div
								class="header-nav-main header-nav-main-square header-nav-main-effect-2 header-nav-main-sub-effect-1"
								data-controller="porto-nav"
							>
								<nav class="collapse" id="mainNav">
									<ul class="nav nav-pills" id="mainNavList">
										{% set currentRoute = app.request.attributes.get('_route') %}
										{% set currentSlug = app.request.attributes.get('slug') %}

										{% for menu in menus %}
											{% set elementsVisibles = menu.elementMenu|filter(element => element.estVisible) %}
											{% set menuActif = false %}

											{% for element in elementsVisibles %}
												{% set targetPage = element.page %}

												{% if targetPage and currentRoute == 'app_page_show' and targetPage.slug == currentSlug %}
													{% set menuActif = true %}
												{% endif %}
											{% endfor %}

											<li class="{{ elementsVisibles|length > 0 ? 'dropdown' : '' }} {{ menuActif ? 'active' : '' }}">
												{% if elementsVisibles|length > 0 %}
													<a
														href="#"
														class="dropdown-item dropdown-toggle {{ menuActif ? 'active' : '' }}"
														data-action="click->porto-nav#toggle"
													>
														{{ menu.libelle }}
													</a>

													<ul class="dropdown-menu">
														{% for element in elementsVisibles %}
															{% set targetPage = element.page %}
															{% set targetAnchor = element.bloc ? 'bloc-' ~ element.bloc.id : null %}
															{% set targetHref = null %}

															{% if targetPage %}
																{% set targetHref = path('app_page_show', { slug: targetPage.slug }) %}

																{% if targetAnchor %}
																	{% set targetHref = targetHref ~ '#' ~ targetAnchor %}
																{% endif %}
															{% endif %}

															{% set elementActif = targetPage and currentRoute == 'app_page_show' and targetPage.slug == currentSlug %}

															<li>
																{% if targetHref %}
																	<a
																		href="{{ targetHref }}"
																		class="dropdown-item {{ elementActif ? 'active' : '' }}"
																	>
																		{{ element.libelle }}
																	</a>
																{% else %}
																	<span class="dropdown-item text-muted">
																		{{ element.libelle }}
																	</span>
																{% endif %}
															</li>
														{% endfor %}
													</ul>
												{% else %}
													<span class="dropdown-item text-muted">
														{{ menu.libelle }}
													</span>
												{% endif %}
											</li>
										{% endfor %}

										<li class="{{ currentRoute == 'app_contact' ? 'active' : '' }}">
											<a
												href="{{ path('app_contact') }}"
												class="dropdown-item {{ currentRoute == 'app_contact' ? 'active' : '' }}"
											>
												Contact
											</a>
										</li>
									</ul>
								</nav>
							</div>

							<button
								class="btn header-btn-collapse-nav"
								type="button"
								data-bs-toggle="collapse"
								data-bs-target="#mainNav"
								aria-controls="mainNav"
								aria-expanded="false"
								aria-label="Ouvrir le menu"
							>
								☰
							</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>