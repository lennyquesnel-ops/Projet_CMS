<nav class="site-navbar">
    <div class="site-navbar__inner">
        <a href="#" class="site-navbar__brand">ATAIS Informatique</a>

        <ul class="site-navbar__menu">
            {% set currentRoute = app.request.attributes.get('_route') %}
            {% set currentSlug = app.request.attributes.get('slug') %}

            {% for menu in menus %}
                {% set elementsVisibles = menu.elementMenu|filter(element => element.estVisible) %}
                {% set menuActif = false %}

                {% for element in elementsVisibles %}
                    {% set targetPage = element.page %}
                    {% if not targetPage and element.bloc and element.bloc.page %}
                        {% set targetPage = element.bloc.page %}
                    {% endif %}

                    {% if targetPage and currentRoute == 'app_page_show' and targetPage.slug == currentSlug %}
                        {% set menuActif = true %}
                    {% endif %}
                {% endfor %}

                <li class="site-navbar__item {{ elementsVisibles|length > 0 ? 'has-dropdown' : '' }} {{ menuActif ? 'is-active' : '' }}">
                    <span class="site-navbar__link">
                        {{ menu.libelle }}
                    </span>

                    {% if elementsVisibles|length > 0 %}
                        <ul class="site-navbar__dropdown">
                            {% for element in elementsVisibles %}
                                {% set targetPage = element.page %}
                                {% if not targetPage and element.bloc and element.bloc.page %}
                                    {% set targetPage = element.bloc.page %}
                                {% endif %}

                                {% set targetAnchor = element.bloc ? 'bloc-' ~ element.bloc.id : null %}

                                {% set targetHref = null %}
                                {% if targetPage %}
                                    {% set targetHref = path('app_page_show', { slug: targetPage.slug }) %}
                                    {% if targetAnchor %}
                                        {% set targetHref = targetHref ~ '#' ~ targetAnchor %}
                                    {% endif %}
                                {% endif %}

                                {% set elementActif = targetPage and currentRoute == 'app_page_show' and targetPage.slug == currentSlug %}

                                <li class="site-navbar__dropdown-item">
                                    {% if targetHref %}
                                        <a href="{{ targetHref }}"
                                           class="site-navbar__dropdown-link {{ elementActif ? 'is-active' : '' }}">
                                            {{ element.libelle }}
                                        </a>
                                    {% else %}
                                        <span class="site-navbar__dropdown-link is-disabled">
                                            {{ element.libelle }}
                                        </span>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </div>
</nav>