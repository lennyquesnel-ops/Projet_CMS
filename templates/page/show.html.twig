{% extends 'base.html.twig' %}

{% block title %}{{ page.slug }}{% endblock %}

{% block body %}
    <div class="page-contenu">
        {% for bloc in page.bloc %}
            {% if bloc.estVisible %}
                <section class="bloc-contenu">
                    {{ bloc.contenu|raw }}
                </section>
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}