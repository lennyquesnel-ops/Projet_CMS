{% extends 'base.html.twig' %}

{% set pageTitle = page.slug|replace({'-': ' '})|title %}

{% block title %}{{ pageTitle }} - ATAIS Informatique{% endblock %}

{% block body %}
	{% for pageBloc in page.pageBlocs %}
		{% set bloc = pageBloc.bloc %}

		{% if bloc and bloc.estVisible %}
			<div id="bloc-{{ bloc.id }}"></div>
			{{ bloc.contenu|raw }}
		{% endif %}
	{% else %}
		<section class="section border-0 m-0 py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-lg-8 text-center">
						<h1 class="font-weight-bold text-color-dark mb-3">
							{{ pageTitle }}
						</h1>

						<p class="text-4 text-color-default">
							Aucun bloc n’est encore associé à cette page.
						</p>
					</div>
				</div>
			</div>
		</section>
	{% endfor %}
{% endblock %}