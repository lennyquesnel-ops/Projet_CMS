{% extends 'base.html.twig' %}

{% set pageTitle = page.slug|replace({'-': ' '})|title %}

{% block title %}{{ pageTitle }}{% endblock %}

{% block body %}
    <div class="page-wrapper">
        <header class="page-header">
            <h1 class="page-title">{{ pageTitle }}</h1>
        </header>

        <div class="page-contenu">
            {% for pageBloc in page.pageBlocs %}
                {% set bloc = pageBloc.bloc %}

                {% if bloc and bloc.estVisible %}
                    <section id="bloc-{{ bloc.id }}" class="page-section">
                        <div class="bloc-contenu">
                            {{ bloc.contenu|raw }}
                        </div>
                    </section>
                {% endif %}
            {% else %}
                <p>Aucun bloc n’est encore associé à cette page.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}