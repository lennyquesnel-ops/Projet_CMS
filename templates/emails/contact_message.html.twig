<h1>Nouveau message depuis le formulaire de contact</h1>

<p>
    Un nouveau message a été envoyé depuis le site ATAIS Informatique.
</p>

<table cellpadding="8" cellspacing="0" border="0">
    <tr>
        <th align="left">Nom</th>
        <td>{{ contact.nom }}</td>
    </tr>
    <tr>
        <th align="left">Prénom</th>
        <td>{{ contact.prenom }}</td>
    </tr>
    <tr>
        <th align="left">Email</th>
        <td>{{ contact.email }}</td>
    </tr>
    <tr>
        <th align="left">Objet</th>
        <td>{{ contact.objet }}</td>
    </tr>
    <tr>
        <th align="left">Date</th>
        <td>{{ contact.date ? contact.date|date('d/m/Y') : '' }}</td>
    </tr>
</table>

<h2>Message</h2>
<p style="white-space: pre-line;">{{ contact.message }}</p>