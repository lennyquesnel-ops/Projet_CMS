{% set menu = entity.instance %}

<div class="admin-link-list">
    {% for elementMenu in menu.elementMenu %}
        {% set elementLibelle = elementMenu.libelle is not empty ? elementMenu.libelle : 'Élément #' ~ elementMenu.id %}

        <a
            href="{{ ea_url()
                .setController('App\\Controller\\Admin\\ElementMenuCrudController')
                .setAction('edit')
                .setEntityId(elementMenu.id)
            }}"
            class="admin-related-link admin-related-link--menu"
            title="Modifier cet élément de menu"
        >
            <span class="admin-related-link__order">{{ elementMenu.ordre }}</span>
            <span class="admin-related-link__label">{{ elementLibelle }}</span>
        </a>
    {% else %}
        <span class="admin-empty-value">Aucun élément de menu</span>
    {% endfor %}
</div>