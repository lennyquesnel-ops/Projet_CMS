{% set elementMenu = entity.instance %}
{% set menu = elementMenu.menu %}

{% if menu %}
    {% set menuLibelle = menu.libelle is not empty ? menu.libelle : 'Menu #' ~ menu.id %}

    <div class="admin-link-list admin-link-list--single">
        <a
            href="{{ ea_url()
                .setController('App\\Controller\\Admin\\MenuCrudController')
                .setAction('edit')
                .setEntityId(menu.id)
            }}"
            class="admin-related-link admin-related-link--menu"
            title="Modifier ce menu"
        >
            <span class="admin-related-link__label">{{ menuLibelle }}</span>
        </a>
    </div>
{% else %}
    <span class="admin-empty-value">Aucun menu</span>
{% endif %}