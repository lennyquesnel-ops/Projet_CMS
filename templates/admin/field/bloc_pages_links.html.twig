{% set bloc = entity.instance %}

<div class="admin-link-list">
    {% for pageBloc in bloc.pageBlocs %}
        {% set page = pageBloc.page %}

        {% if page %}
            {% set pageLibelle = page.slug is not empty ? page.slug : 'Page #' ~ page.id %}

            <a
                href="{{ ea_url()
                    .setController('App\\Controller\\Admin\\PageCrudController')
                    .setAction('edit')
                    .setEntityId(page.id)
                }}"
                class="admin-related-link admin-related-link--page"
                title="Modifier cette page"
            >
                <span class="admin-related-link__order">{{ pageBloc.ordre }}</span>
                <span class="admin-related-link__label">{{ pageLibelle }}</span>
            </a>
        {% endif %}
    {% else %}
        <span class="admin-empty-value">Aucune page</span>
    {% endfor %}
</div>