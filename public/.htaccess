DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cache statique généré : accueil
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{DOCUMENT_ROOT}/static/index.html -f
    RewriteRule ^$ static/index.html [L]

    # Cache statique généré : pages publiques /page/slug
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{DOCUMENT_ROOT}/static/page/$1/index.html -f
    RewriteRule ^page/([^/]+)/?$ static/page/$1/index.html [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>